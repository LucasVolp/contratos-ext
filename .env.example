WEB_PORT=3100
API_PORT=4100
POSTGRES_PORT=5540
POSTGRES_USER=contracts
POSTGRES_PASSWORD=contracts_local
POSTGRES_DB=contracts
DATABASE_URL=postgresql://contracts:contracts_local@localhost:5540/contracts
# Go ETL connection; sslmode=disable is for the local Compose PostgreSQL only.
FINANCE_DATABASE_URL=postgresql://contracts:contracts_local@localhost:5540/contracts?sslmode=disable
FINANCE_CACHE_DIR=./data/finance
# Public sources replicator connection; falls back to FINANCE_DATABASE_URL, then DATABASE_URL.
SOURCES_DATABASE_URL=postgresql://contracts:contracts_local@localhost:5540/contracts?sslmode=disable
API_INTERNAL_URL=http://localhost:4100
GOTENBERG_URL=http://localhost:3055
GOTENBERG_PORT=3055
COMPRAS_API_BASE_URL=https://dadosabertos.compras.gov.br

# Optional initial manager, created only when no accounts exist. Set a private password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
