{
  "name": "@contracts/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/build.cjs",
    "start": "node dist/main.js",
    "test": "pnpm run build && tsx --test test/*.test.ts && node --test test/production/*.test.cjs",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:production": "pnpm run build && node --test test/production/*.test.cjs",
    "db:repair-demo-identifiers": "tsx scripts/repair-demo-identifiers.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "decimal.js": "^10.6.0",
    "docxtemplater": "^3.67.6",
    "pizzip": "^3.2.0",
    "@contracts/validation": "workspace:*",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6"
  }
}
