{
  "name": "contracts-ext",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @contracts/api build && pnpm --filter @contracts/web build",
    "test": "pnpm --filter @contracts/validation test && pnpm --filter @contracts/api test",
    "lint": "pnpm --filter @contracts/api lint && pnpm --filter @contracts/web lint",
    "dev": "pnpm -r --parallel dev",
    "containers:dev": "docker compose up --build -d --wait",
    "containers:update": "docker compose up --build -d --wait",
    "containers:prod": "docker compose -f compose.yaml up --build -d --wait",
    "db:migrate": "pnpm --filter @contracts/api db:migrate",
    "db:seed": "pnpm --filter @contracts/api db:seed",
    "finance:import": "node scripts/finance-etl.cjs",
    "sources:sync": "node scripts/sources-sync.cjs sync",
    "sources:normalize": "node scripts/sources-sync.cjs normalize",
    "sources:daily": "node scripts/sources-sync.cjs daily",
    "test:e2e": "playwright test",
    "auth:create-manager": "pnpm --filter @contracts/api auth:create-manager",
    "db:seed-institutions": "pnpm --filter @contracts/api db:seed-institutions"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
